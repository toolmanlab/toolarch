<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ToolArch Report</title>
    <style>
        :root { --bg: #0d1117; --fg: #c9d1d9; --card: #161b22; --border: #30363d; --accent: #58a6ff; --red: #f85149; --yellow: #d29922; --green: #3fb950; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; background: var(--bg); color: var(--fg); padding: 2rem; line-height: 1.6; }
        h1 { color: var(--accent); margin-bottom: 0.5rem; }
        .meta { color: #8b949e; margin-bottom: 2rem; }
        .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
        .card { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; }
        .card .value { font-size: 2rem; font-weight: bold; color: var(--accent); }
        .card .label { color: #8b949e; font-size: 0.85rem; }
        .section { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem; }
        .section h2 { color: var(--accent); margin-bottom: 1rem; font-size: 1.2rem; }
        .issue { padding: 0.5rem 0; border-bottom: 1px solid var(--border); }
        .issue:last-child { border-bottom: none; }
        .severity-high { color: var(--red); font-weight: bold; }
        .severity-medium { color: var(--yellow); }
        .severity-low { color: #8b949e; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid var(--border); }
        th { color: #8b949e; font-size: 0.85rem; text-transform: uppercase; }
    </style>
</head>
<body>
    <h1>ToolArch Analysis Report</h1>
    <p class="meta">{{ summary.root_path }} &middot; {{ summary.lang }}</p>

    <div class="cards">
        <div class="card">
            <div class="value">{{ summary.total_nodes }}</div>
            <div class="label">Nodes</div>
        </div>
        <div class="card">
            <div class="value">{{ summary.total_edges }}</div>
            <div class="label">Edges</div>
        </div>
        <div class="card">
            <div class="value">{{ summary.total_issues }}</div>
            <div class="label">Issues</div>
        </div>
        <div class="card">
            <div class="value {% if summary.high_severity_count > 0 %}severity-high{% endif %}">{{ summary.high_severity_count }}</div>
            <div class="label">High Severity</div>
        </div>
    </div>

    {% for result in results %}
    <div class="section">
        <h2>{{ result.analyzer }}</h2>
        {% if result.summary %}<p>{{ result.summary }}</p>{% endif %}

        {% if result.issues %}
        <div style="margin-top: 1rem;">
            {% for issue in result.issues %}
            <div class="issue">
                <span class="severity-{{ issue.severity.value }}">{{ issue.severity.value | upper }}</span>
                {{ issue.message }}
                {% if issue.location %}<span style="color: #8b949e;">({{ issue.location }})</span>{% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {% if result.metrics %}
        <table style="margin-top: 1rem;">
            <thead><tr><th>Node</th><th>Metric</th><th>Value</th></tr></thead>
            <tbody>
            {% for m in result.metrics[:20] %}
            <tr><td>{{ m.node_id }}</td><td>{{ m.name }}</td><td>{{ "%.2f" | format(m.value) }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>
    {% endfor %}

    <p style="color: #8b949e; text-align: center; margin-top: 2rem;">Generated by ToolArch v0.1.0</p>
</body>
</html>
